      "name": "agent-01",
      "host": "local",
      "platform": "macos",
      "hermes_home": "~/.hermes",
      "enabled": true,
      "role": "origin",
      "authoring": true
    },
    {
      "name": "agent-02",
      "host": "USER@10.0.0.2",
      "platform": "windows",
      "hermes_home": "%LOCALAPPDATA%\\hermes",
      "enabled": true,
      "role": "sentinel",
      "authoring": false
    },
    {
      "name": "agent-03",
